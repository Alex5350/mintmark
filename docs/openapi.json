  "components": {
    "schemas": {
      "ConfirmIdentificationRequest": {
        "required": [
          "coinTypeId"
        ],
        "type": "object",
        "properties": {
          "coinTypeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "correctedBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateHoldingRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "coinTypeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "itemForm": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ItemForm"
              }
            ]
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "purchasePricePerUnit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyInput"
              }
            ]
          },
          "purchaseDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dealer": {
            "type": [
              "null",
              "string"
            ]
          },
          "storageLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "serialNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "IFormFileCollection": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/IFormFile"
        }
      },
      "ItemForm": {
        "type": "integer"
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MoneyInput": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "PresignUploadRequest": {
        "required": [
          "contentType",
          "contentLengthBytes"
        ],
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string"
          },
          "contentLengthBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterImageRequest": {
        "required": [
          "holdingId",
          "side",
          "uploadKey"
        ],
        "type": "object",
        "properties": {
          "holdingId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "side": {
            "type": "string"
          },
          "uploadKey": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateHoldingRequest": {
        "required": [
          "quantity",
          "purchasePricePerUnit",
          "reason"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "purchasePricePerUnit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyInput"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
