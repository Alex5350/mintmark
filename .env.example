# ---------------------------------------------------------------------------
# Mintmark environment. Copy to .env (backend) or export before running.
# Names + descriptions only — NEVER put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Database (docker compose up db) ---
MINTMARK_DATABASE=Host=localhost;Port=5434;Database=mintmark;Username=mintmark;Password=mintmark

# --- API ---
MINTMARK_ENVIRONMENT=Development
# Generate with: openssl rand -base64 48
MINTMARK_JWT_SIGNING_KEY=change-me-min-64-random-bytes
MINTMARK_JWT_ISSUER=mintmark-api
MINTMARK_JWT_AUDIENCE=mintmark-clients
# Minutes; access tokens are intentionally short-lived
MINTMARK_ACCESS_TOKEN_MINUTES=15
MINTMARK_REFRESH_TOKEN_DAYS=30

# --- Object storage (compose service `storage`; MinIO locally, S3-compatible in prod) ---
MINTMARK_STORAGE_ENDPOINT=localhost:9000
MINTMARK_STORAGE_ACCESS_KEY=mintmark
MINTMARK_STORAGE_SECRET_KEY=mintmark-dev-only
MINTMARK_STORAGE_BUCKET=mintmark-images
MINTMARK_STORAGE_USE_SSL=false

# --- Spot price providers (pick from docs/adr/0004; keys from each provider's dashboard) ---
# Primary provider: see ADR 0004 for selection rationale and licensing terms.
MINTMARK_PRICE_PRIMARY=metalpriceapi
MINTMARK_PRICE_PRIMARY_KEY=
# Fallback provider
MINTMARK_PRICE_FALLBACK=metalsdev
MINTMARK_PRICE_FALLBACK_KEY=
# Monthly request budget ACROSS providers; the poller derives a safe interval from this.
MINTMARK_PRICE_MONTHLY_BUDGET=250
MINTMARK_PRICE_BASE_CURRENCY=USD

# --- AI identification (vision model) ---
# Unset key => the deterministic offline evaluator serves identification in
# dev/test (clearly labeled in every response); see docs/ai-pipeline.md.
MINTMARK_VISION_PROVIDER=offline
MINTMARK_VISION_MODEL=
MINTMARK_OPENAI_API_KEY=
MINTMARK_GEMINI_API_KEY=
# Per-user identification runs per day
MINTMARK_IDENTIFY_DAILY_LIMIT=25

# --- Observability (OTLP; point at any collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
