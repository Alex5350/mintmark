<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-isolated restore: nuget.org only, ignoring machine-level private
     sources, with source mapping so central package management stays
     warning-clean (NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
